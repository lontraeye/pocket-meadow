# Bloco do Pocket Meadow no /etc/caddy/Caddyfile da VM. Acrescentar ao arquivo,
# sem substituir os outros blocos, e depois: sudo systemctl reload caddy
pocket.lontraeye.com {
	encode zstd gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /opt/pocket-meadow/current/web

		# JS, CSS e fontes do Vite têm hash no nome: nunca mudam.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Sprites, sons e molduras quase nunca mudam. Passado um dia, o navegador usa
		# o que tem e confere em segundo plano, sem travar a tela.
		@art path /sprites/* /sounds/* /ui/* /favicon.svg
		header @art Cache-Control "public, max-age=86400, stale-while-revalidate=2592000"

		# O index aponta para os arquivos com hash: sempre conferido, para um
		# deploy novo aparecer na hora.
		@page not path /assets/* /sprites/* /sounds/* /ui/* /favicon.svg
		header @page Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
