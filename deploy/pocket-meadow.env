# /etc/pocket-meadow.env
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/pocket-meadow/meadow.sqlite
# Só o Caddy da VM fala com a API, e ele reescreve o X-Forwarded-For.
TRUST_PROXY=1
# Login pelo Google (PLANNING.md, seção 4.7). O secret vai só no arquivo da VM,
# nunca no git: por isso o arquivo da VM é 600 e de root.
PUBLIC_URL=https://pocket.lontraeye.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
