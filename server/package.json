{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed-species.ts",
    "sprites:download": "tsx scripts/download-sprites.ts",
    "sprites:pmd": "tsx scripts/pmd-sprites.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.11",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
